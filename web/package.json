{
  "name": "seller-hub",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:simulado": "ng serve --configuration simulado",
    "api:simulada": "node ferramentas/api-simulada.mjs",
    "test:simulador": "node --test ferramentas/api-simulada.test.mjs",
    "test:api-real": "node ferramentas/verificar-api-real.mjs",
    "test:e2e": "playwright test",
    "test:e2e:gravar": "playwright test --config=playwright.gravacao.config.ts",
    "test:e2e:relatorio": "playwright show-report",
    "test:e2e:tipos": "tsc -p e2e/tsconfig.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
